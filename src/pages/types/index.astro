---
import Base from "../../layouts/Base.astro";
import { TYPES } from "../../data/types";
import { robotSvg } from "../../lib/robot";
import { typeCodes } from "../../lib/scoring";
import { withBase } from "../../lib/paths";
---

<Base title="16タイプ一覧" description="AIパートナータイプ診断の16体のロボットを紹介します。">
  <h1>16タイプ一覧</h1>
  <ul class="grid">
    {typeCodes().map((code) => (
      <li>
        <a href={withBase(`types/${code}/`)}>
          <div class="robot" set:html={robotSvg(code)} />
          <span>{TYPES[code].name}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="cta"><a class="button" href={withBase("quiz/")}>診断をはじめる</a></p>
</Base>

<style>
  h1 { text-align: center; font-size: 1.6rem; }
  .grid { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  @media (min-width: 560px) { .grid { grid-template-columns: repeat(4, 1fr); } }
  .grid a {
    display: block; background: var(--card); border-radius: 14px; padding: 10px; text-align: center;
    text-decoration: none; color: var(--ink); font-weight: 700; font-size: 0.8rem; line-height: 1.4;
  }
  .grid span { display: block; text-wrap: balance; }
  .cta { text-align: center; margin-top: 24px; }
</style>
